+#pragma once
+
+#include "saige/npc_psychology.hpp"
+#include "saige/npc_simulation.hpp"
+#include "saige/persistent_world.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace saige::economy {
+
+struct HouseholdAccount {
+  world_sim::EntityId npc_id = world_sim::kInvalidEntityId;
+  std::int64_t balance_cents = 0;
+  std::int64_t daily_budget_cents = 5000;
+  std::uint64_t last_paid_tick = 0;
+};
+
+struct EmploymentContract {
+  world_sim::EntityId npc_id = world_sim::kInvalidEntityId;
+  world_sim::VenueId employer_venue = world_sim::kInvalidVenueId;
+  world_sim::OccupationKind role = world_sim::OccupationKind::Shopkeeper;
+  std::int64_t wage_per_minute_cents = 25;
+  std::uint16_t shift_start_min = 480;
+  std::uint16_t shift_end_min = 1020;
+};
+
+struct EconomyBusiness {
+  world_sim::VenueId venue_id = world_sim::kInvalidVenueId;
+  world_sim::VenueCategory category = world_sim::VenueCategory::Commercial;
+  world_sim::WorldPosition anchor{};
+  std::uint16_t open_minute = 480;
+  std::uint16_t close_minute = 1080;
+  std::int64_t cash_cents = 100000;
+  std::uint32_t inventory_units = 50;
+  std::uint32_t max_inventory = 100;
+  std::uint32_t reorder_threshold = 15;
+  std::int64_t unit_price_cents = 1200;
+  std::int64_t wholesale_unit_cost_cents = 600;
+  std::uint64_t assigned_delivery_vehicle = 0;
+  bool delivery_pending = false;
+  bool temporarily_closed = false;
+  std::uint64_t revenue_cents = 0;
+  std::uint64_t expense_cents = 0;
+  std::uint64_t unmet_demand_count = 0;
+
+  [[nodiscard]] bool is_open(std::uint16_t minute_of_day) const noexcept;
+};
+
+struct DeliveryOrder {
+  std::uint32_t order_id = 0;
+  world_sim::VenueId target_venue = world_sim::kInvalidVenueId;
+  std::uint64_t vehicle_id = 0;
+  std::uint32_t units = 0;
+  std::int64_t wholesale_cost_cents = 0;
+  bool completed = false;
+};
+
+enum class PurchaseStatus : std::uint8_t {
+  Success = 0,
+  UnknownAccountOrBusiness = 1,
+  BusinessClosed = 2,
+  OutOfStock = 3,
+  InsufficientFunds = 4,
+};
+
+class EconomySystem {
+ public:
+  explicit EconomySystem(std::int64_t initial_supplier_treasury_cents = 10000000);
+
+  bool register_household(const HouseholdAccount& acc);
+  bool register_business(const EconomyBusiness& biz);
+  bool assign_employment(const EmploymentContract& contract);
+  void register_delivery_vehicle(std::uint64_t vehicle_id);
+
+  [[nodiscard]] const HouseholdAccount* find_household(
+      world_sim::EntityId npc_id) const noexcept;
+  [[nodiscard]] const EconomyBusiness* find_business(
+      world_sim::VenueId venue_id) const noexcept;
+  [[nodiscard]] const std::vector<DeliveryOrder>& delivery_orders() const noexcept {
+    return deliveries_;
+  }
+
+  // Advances attendance-verified wage payouts and automatic delivery dispatches.
+  void step(std::uint64_t tick_id, double dt_seconds,
+            std::uint16_t minute_of_day,
+            const std::vector<world_sim::NpcAgent>& npcs);
+
+  // Executes atomic integer-cents purchase; updates buyer hunger & psychology.
+  PurchaseStatus attempt_purchase(world_sim::EntityId buyer_id,
+                                  world_sim::VenueId venue_id,
+                                  std::uint32_t quantity,
+                                  std::uint16_t minute_of_day,
+                                  world_sim::NpcAgent* buyer_npc = nullptr,
+                                  psychology::NpcPsychologyProfile* buyer_psych = nullptr,
+                                  double current_time_sec = 0.0);
+
+  // Completes a delivery upon vehicle arrival, restocking inventory & reopening.
+  bool complete_delivery(std::uint32_t order_id);
+
+  // Selects an open, stocked, affordable venue (or workplace if low funds).
+  [[nodiscard]] world_sim::VenueId choose_economic_destination(
+      const world_sim::NpcAgent& npc,
+      std::uint16_t minute_of_day) const noexcept;
+
+  void sync_to_persistent_store(
+      persistent_world::PersistentWorldStore& store) const;
+  void load_from_persistent_store(
+      const persistent_world::PersistentWorldStore& store);
+
+  // Total currency across all households + businesses + supplier treasury.
+  [[nodiscard]] std::int64_t total_money_cents() const noexcept;
+  [[nodiscard]] std::int64_t supplier_treasury_cents() const noexcept {
+    return supplier_treasury_cents_;
+  }
+
+ private:
+  std::int64_t supplier_treasury_cents_ = 0;
+  std::uint32_t next_order_id_ = 1;
+  std::vector<HouseholdAccount> households_;
+  std::vector<EconomyBusiness> businesses_;
+  std::vector<EmploymentContract> contracts_;
+  std::vector<std::uint64_t> delivery_vehicles_;
+  std::vector<DeliveryOrder> deliveries_;
+};
+
+}  // namespace saige::economy
diff --git a/src/local_economy.cpp b/src/local_economy.cpp
new file mode 100644
--- /dev/null
+++ b/src/local_economy.cpp
@@ -0,0 +1,323 @@
+#include "saige/local_economy.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace saige::economy {
+
+namespace {
+
+[[nodiscard]] bool in_minute_window(std::uint16_t m, std::uint16_t start,
+                                    std::uint16_t end) noexcept {
+  if (start == end) return true;
+  if (start < end) return m >= start && m < end;
+  return m >= start || m < end;
+}
+
+}  // namespace
+
+bool EconomyBusiness::is_open(std::uint16_t minute_of_day) const noexcept {
+  return !temporarily_closed &&
+         in_minute_window(minute_of_day, open_minute, close_minute);
+}
+
+EconomySystem::EconomySystem(std::int64_t initial_supplier_treasury_cents)
+    : supplier_treasury_cents_(initial_supplier_treasury_cents) {}
+
+bool EconomySystem::register_household(const HouseholdAccount& acc) {
+  if (acc.npc_id == world_sim::kInvalidEntityId || acc.balance_cents < 0) {
+    return false;
+  }
+  for (const auto& h : households_) {
+    if (h.npc_id == acc.npc_id) return false;
+  }
+  households_.push_back(acc);
+  return true;
+}
+
+bool EconomySystem::register_business(const EconomyBusiness& biz) {
+  if (biz.venue_id == world_sim::kInvalidVenueId || biz.unit_price_cents < 0 ||
+      biz.wholesale_unit_cost_cents < 0) {
+    return false;
+  }
+  for (const auto& b : businesses_) {
+    if (b.venue_id == biz.venue_id) return false;
+  }
+  businesses_.push_back(biz);
+  return true;
+}
+
+bool EconomySystem::assign_employment(const EmploymentContract& contract) {
+  if (contract.npc_id == world_sim::kInvalidEntityId ||
+      contract.employer_venue == world_sim::kInvalidVenueId ||
+      contract.wage_per_minute_cents < 0) {
+    return false;
+  }
+  for (auto& c : contracts_) {
+    if (c.npc_id == contract.npc_id) {
+      c = contract;
+      return true;
+    }
+  }
+  contracts_.push_back(contract);
+  return true;
+}
+
+void EconomySystem::register_delivery_vehicle(std::uint64_t vehicle_id) {
+  if (vehicle_id == 0) return;
+  if (std::find(delivery_vehicles_.begin(), delivery_vehicles_.end(),
+                vehicle_id) == delivery_vehicles_.end()) {
+    delivery_vehicles_.push_back(vehicle_id);
+  }
+}
+
+const HouseholdAccount* EconomySystem::find_household(
+    world_sim::EntityId npc_id) const noexcept {
+  for (const auto& h : households_) {
+    if (h.npc_id == npc_id) return &h;
+  }
+  return nullptr;
+}
+
+const EconomyBusiness* EconomySystem::find_business(
+    world_sim::VenueId venue_id) const noexcept {
+  for (const auto& b : businesses_) {
+    if (b.venue_id == venue_id) return &b;
+  }
+  return nullptr;
+}
+
+void EconomySystem::step(std::uint64_t tick_id, double dt_seconds,
+                         std::uint16_t minute_of_day,
+                         const std::vector<world_sim::NpcAgent>& npcs) {
+  if (!std::isfinite(dt_seconds) || dt_seconds <= 0.0) return;
+
+  // 1. Pay wages only for physical attendance during scheduled shift (no duplicate ticks)
+  for (const auto& c : contracts_) {
+    if (!in_minute_window(minute_of_day, c.shift_start_min, c.shift_end_min)) {
+      continue;
+    }
+    const world_sim::NpcAgent* worker = nullptr;
+    for (const auto& n : npcs) {
+      if (n.id == c.npc_id) {
+        worker = &n;
+        break;
+      }
+    }
+    if (worker == nullptr) continue;
+
+    HouseholdAccount* hh = nullptr;
+    for (auto& h : households_) {
+      if (h.npc_id == c.npc_id) {
+        hh = &h;
+        break;
+      }
+    }
+    EconomyBusiness* biz = nullptr;
+    for (auto& b : businesses_) {
+      if (b.venue_id == c.employer_venue) {
+        biz = &b;
+        break;
+      }
+    }
+    if (hh == nullptr || biz == nullptr) continue;
+    if (hh->last_paid_tick == tick_id) continue;  // Prevent duplicate payment on same tick
+
+    const double dist =
+        world_sim::WorldPosition::distance(worker->position, biz->anchor);
+    if (dist <= 6.0) {
+      const std::int64_t pay = std::max<std::int64_t>(
+          1, static_cast<std::int64_t>(
+                 std::llround((dt_seconds / 60.0) *
+                              static_cast<double>(c.wage_per_minute_cents))));
+      if (biz->cash_cents >= pay) {
+        biz->cash_cents -= pay;
+        biz->expense_cents += static_cast<std::uint64_t>(pay);
+        hh->balance_cents += pay;
+        hh->last_paid_tick = tick_id;
+      }
+    }
+  }
+
+  // 2. Trigger supply delivery orders when inventory falls to reorder threshold
+  for (auto& biz : businesses_) {
+    if (biz.inventory_units <= biz.reorder_threshold && !biz.delivery_pending) {
+      const std::uint32_t order_units =
+          (biz.max_inventory > biz.inventory_units)
+              ? (biz.max_inventory - biz.inventory_units)
+              : 0;
+      if (order_units > 0) {
+        const std::int64_t cost =
+            static_cast<std::int64_t>(order_units) * biz.wholesale_unit_cost_cents;
+        if (biz.cash_cents >= cost) {
+          std::uint64_t veh = biz.assigned_delivery_vehicle;
+          if (veh == 0 && !delivery_vehicles_.empty()) {
+            veh = delivery_vehicles_[deliveries_.size() % delivery_vehicles_.size()];
+          }
+          if (veh != 0) {
+            deliveries_.push_back(
+                {next_order_id_++, biz.venue_id, veh, order_units, cost, false});
+            biz.delivery_pending = true;
+          }
+        }
+      }
+    }
+  }
+}
+
+PurchaseStatus EconomySystem::attempt_purchase(
+    world_sim::EntityId buyer_id, world_sim::VenueId venue_id,
+    std::uint32_t quantity, std::uint16_t minute_of_day,
+    world_sim::NpcAgent* buyer_npc, psychology::NpcPsychologyProfile* buyer_psych,
+    double current_time_sec) {
+  if (quantity == 0) return PurchaseStatus::UnknownAccountOrBusiness;
+
+  HouseholdAccount* hh = nullptr;
+  for (auto& h : households_) {
+    if (h.npc_id == buyer_id) {
+      hh = &h;
+      break;
+    }
+  }
+  EconomyBusiness* biz = nullptr;
+  for (auto& b : businesses_) {
+    if (b.venue_id == venue_id) {
+      biz = &b;
+      break;
+    }
+  }
+  if (hh == nullptr || biz == nullptr) {
+    return PurchaseStatus::UnknownAccountOrBusiness;
+  }
+  if (!biz->is_open(minute_of_day)) {
+    ++biz->unmet_demand_count;
+    return PurchaseStatus::BusinessClosed;
+  }
+  if (biz->inventory_units < quantity) {
+    ++biz->unmet_demand_count;
+    if (biz->inventory_units == 0) {
+      biz->temporarily_closed = true;
+    }
+    return PurchaseStatus::OutOfStock;
+  }
+
+  const std::int64_t total_cost =
+      static_cast<std::int64_t>(quantity) * biz->unit_price_cents;
+  if (hh->balance_cents < total_cost) {
+    return PurchaseStatus::InsufficientFunds;
+  }
+
+  hh->balance_cents -= total_cost;
+  biz->cash_cents += total_cost;
+  biz->revenue_cents += static_cast<std::uint64_t>(total_cost);
+  biz->inventory_units -= quantity;
+  if (biz->inventory_units == 0) {
+    biz->temporarily_closed = true;
+  }
+
+  if (buyer_npc != nullptr) {
+    buyer_npc->drives.hunger = std::max(0.0, buyer_npc->drives.hunger - 0.5);
+  }
+  if (buyer_psych != nullptr) {
+    buyer_psych->record_experience(
+        {venue_id, world_sim::kInvalidEntityId, 0.4, current_time_sec});
+  }
+  return PurchaseStatus::Success;
+}
+
+bool EconomySystem::complete_delivery(std::uint32_t order_id) {
+  for (auto& d : deliveries_) {
+    if (d.order_id == order_id && !d.completed) {
+      for (auto& biz : businesses_) {
+        if (biz.venue_id == d.target_venue) {
+          if (biz.cash_cents < d.wholesale_cost_cents) return false;
+          biz.cash_cents -= d.wholesale_cost_cents;
+          biz.expense_cents += static_cast<std::uint64_t>(d.wholesale_cost_cents);
+          supplier_treasury_cents_ += d.wholesale_cost_cents;
+          biz.inventory_units =
+              std::min(biz.max_inventory, biz.inventory_units + d.units);
+          biz.delivery_pending = false;
+          if (biz.inventory_units > 0) {
+            biz.temporarily_closed = false;
+          }
+          d.completed = true;
+          return true;
+        }
+      }
+    }
+  }
+  return false;
+}
+
+world_sim::VenueId EconomySystem::choose_economic_destination(
+    const world_sim::NpcAgent& npc,
+    std::uint16_t minute_of_day) const noexcept {
+  const HouseholdAccount* hh = find_household(npc.id);
+  const std::int64_t funds = hh ? hh->balance_cents : 0;
+
+  if (npc.drives.hunger > 0.65) {
+    double best_dist = 1e18;
+    world_sim::VenueId best_id = world_sim::kInvalidVenueId;
+    for (const auto& biz : businesses_) {
+      if (!biz.is_open(minute_of_day) || biz.inventory_units == 0) continue;
+      if (funds < biz.unit_price_cents) continue;
+      const double d = world_sim::WorldPosition::distance(npc.position, biz.anchor);
+      if (d < best_dist) {
+        best_dist = d;
+        best_id = biz.venue_id;
+      }
+    }
+    if (best_id != world_sim::kInvalidVenueId) return best_id;
+  }
+
+  for (const auto& c : contracts_) {
+    if (c.npc_id == npc.id &&
+        in_minute_window(minute_of_day, c.shift_start_min, c.shift_end_min)) {
+      return c.employer_venue;
+    }
+  }
+  return npc.persistent_memory.home_venue;
+}
+
+void EconomySystem::sync_to_persistent_store(
+    persistent_world::PersistentWorldStore& store) const {
+  for (const auto& hh : households_) {
+    store.set_npc_balance(hh.npc_id, hh.balance_cents);
+  }
+  for (const auto& biz : businesses_) {
+    persistent_world::BusinessRecord rec{};
+    rec.venue_id = biz.venue_id;
+    rec.category = biz.category;
+    rec.anchor = biz.anchor;
+    rec.open_minute = biz.open_minute;
+    rec.close_minute = biz.close_minute;
+    rec.inventory_units = biz.inventory_units;
+    rec.unit_price = static_cast<double>(biz.unit_price_cents) / 100.0;
+    rec.cumulative_revenue_cents = biz.revenue_cents;
+    store.upsert_business(rec);
+  }
+}
+
+void EconomySystem::load_from_persistent_store(
+    const persistent_world::PersistentWorldStore& store) {
+  for (auto& hh : households_) {
+    if (const auto* rec = store.find_npc(hh.npc_id)) {
+      hh.balance_cents = rec->balance_cents;
+    }
+  }
+  for (auto& biz : businesses_) {
+    if (const auto* rec = store.find_business(biz.venue_id)) {
+      biz.inventory_units = rec->inventory_units;
+      biz.revenue_cents = rec->cumulative_revenue_cents;
+    }
+  }
+}
+
+std::int64_t EconomySystem::total_money_cents() const noexcept {
+  std::int64_t sum = supplier_treasury_cents_;
+  for (const auto& h : households_) sum += h.balance_cents;
+  for (const auto& b : businesses_) sum += b.cash_cents;
+  return sum;
+}
+
+}  // namespace saige::economy
diff --git a/tests/local_economy_test.cpp b/tests/local_economy_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/local_economy_test.cpp
@@ -0,0 +1,148 @@
+#include "saige/local_economy.hpp"
+
+#include <cstdlib>
+#include <iostream>
+
+#define SAIGE_CHECK(cond)                                                     \
+  do {                                                                        \
+    if (!(cond)) {                                                            \
+      std::cerr << "SAIGE_CHECK FAILED at " << __FILE__ << ":" << __LINE__    \
+                << " (" << #cond << ")\n";                                    \
+      std::exit(1);                                                           \
+    }                                                                         \
+  } while (false)
+
+using namespace saige::economy;
+using namespace saige::world_sim;
+using namespace saige::psychology;
+using namespace saige::persistent_world;
+
+namespace {
+
+void test_wage_attendance_and_duplicate_tick_guard() {
+  EconomySystem econ(100000);
+  const std::int64_t initial_total = econ.total_money_cents();
+
+  SAIGE_CHECK(econ.register_household({1, 0, 5000, 0}));
+  EconomyBusiness shop{};
+  shop.venue_id = 10;
+  shop.anchor = WorldPosition::from_world_double({20.0, 0.0, 0.0});
+  shop.cash_cents = 50000;
+  SAIGE_CHECK(econ.register_business(shop));
+  SAIGE_CHECK(econ.assign_employment({1, 10, OccupationKind::Shopkeeper, 25, 480, 1020}));
+
+  NpcAgent worker{};
+  worker.id = 1;
+  worker.position = WorldPosition::from_world_double({80.0, 0.0, 0.0});  // Absent
+  std::vector<NpcAgent> npcs{worker};
+
+  econ.step(1, 60.0, 540, npcs);
+  SAIGE_CHECK(econ.find_household(1)->balance_cents == 0);  // Absent -> 0 pay
+
+  npcs[0].position = WorldPosition::from_world_double({21.0, 0.0, 0.0});  // Present
+  econ.step(2, 60.0, 540, npcs);
+  SAIGE_CHECK(econ.find_household(1)->balance_cents == 25);
+
+  // Duplicate step with same tick_id=2 must NOT double-pay
+  econ.step(2, 60.0, 540, npcs);
+  SAIGE_CHECK(econ.find_household(1)->balance_cents == 25);
+  SAIGE_CHECK(econ.total_money_cents() == initial_total + 50000);
+}
+
+void test_purchase_insufficient_funds_exhaustion_and_delivery() {
+  EconomySystem econ(1000000);
+  econ.register_delivery_vehicle(900);
+  SAIGE_CHECK(econ.register_household({1, 500, 5000, 0}));   // Poor ($5.00)
+  SAIGE_CHECK(econ.register_household({2, 5000, 5000, 0}));  // Solvent ($50.00)
+
+  EconomyBusiness cafe{};
+  cafe.venue_id = 1;
+  cafe.anchor = WorldPosition::from_world_double({10.0, 0.0, 0.0});
+  cafe.cash_cents = 100000;
+  cafe.inventory_units = 2;
+  cafe.max_inventory = 10;
+  cafe.reorder_threshold = 1;
+  cafe.unit_price_cents = 1200;
+  cafe.wholesale_unit_cost_cents = 500;
+  SAIGE_CHECK(econ.register_business(cafe));
+
+  const std::int64_t total_before = econ.total_money_cents();
+
+  // Insufficient funds
+  SAIGE_CHECK(econ.attempt_purchase(1, 1, 1, 600) == PurchaseStatus::InsufficientFunds);
+
+  // Solvent buyer buys all 2 units -> inventory exhausted -> temporarily closed
+  NpcAgent buyer{};
+  buyer.id = 2;
+  buyer.drives.hunger = 0.9;
+  NpcPsychologyProfile psych(2);
+  SAIGE_CHECK(econ.attempt_purchase(2, 1, 2, 600, &buyer, &psych, 10.0) ==
+              PurchaseStatus::Success);
+  SAIGE_CHECK(econ.find_household(2)->balance_cents == 2600);
+  SAIGE_CHECK(econ.find_business(1)->temporarily_closed);
+  SAIGE_CHECK(buyer.drives.hunger < 0.5);
+  SAIGE_CHECK(psych.venue_affinity(1) > 0.0);
+
+  // Attempting another purchase while closed fails
+  SAIGE_CHECK(econ.attempt_purchase(2, 1, 1, 600) == PurchaseStatus::BusinessClosed);
+
+  // Step dispatches delivery vehicle 900; completing delivery restocks & reopens
+  econ.step(1, 1.0, 600, {});
+  SAIGE_CHECK(econ.delivery_orders().size() == 1);
+  SAIGE_CHECK(econ.delivery_orders()[0].vehicle_id == 900);
+  SAIGE_CHECK(econ.complete_delivery(econ.delivery_orders()[0].order_id));
+  SAIGE_CHECK(!econ.find_business(1)->temporarily_closed);
+  SAIGE_CHECK(econ.find_business(1)->inventory_units == 10);
+
+  // Exact integer currency conservation across all transactions
+  SAIGE_CHECK(econ.total_money_cents() == total_before);
+}
+
+void test_economic_destinations_and_save_load_consistency() {
+  EconomySystem econ(100000);
+  SAIGE_CHECK(econ.register_household({1, 3000, 5000, 0}));
+  EconomyBusiness b1{};
+  b1.venue_id = 10;
+  b1.anchor = WorldPosition::from_world_double({5.0, 0.0, 0.0});
+  b1.inventory_units = 0;
+  b1.temporarily_closed = true;
+  EconomyBusiness b2{};
+  b2.venue_id = 20;
+  b2.anchor = WorldPosition::from_world_double({30.0, 0.0, 0.0});
+  b2.inventory_units = 10;
+  b2.unit_price_cents = 1000;
+  SAIGE_CHECK(econ.register_business(b1));
+  SAIGE_CHECK(econ.register_business(b2));
+
+  NpcAgent hungry{};
+  hungry.id = 1;
+  hungry.drives.hunger = 0.85;
+  hungry.position = WorldPosition::from_world_double({0.0, 0.0, 0.0});
+  // Skips closed/empty b1 (closer) and selects stocked b2
+  SAIGE_CHECK(econ.choose_economic_destination(hungry, 600) == 20);
+
+  PersistentWorldStore store;
+  store.upsert_npc({1, hungry.position, SimLodTier::Active, OccupationKind::Unemployed,
+                    0, 0, 0, 3000});
+  econ.sync_to_persistent_store(store);
+  const auto blob = store.serialize();
+
+  PersistentWorldStore restored_store;
+  SAIGE_CHECK(restored_store.deserialize(blob));
+  EconomySystem restored_econ(100000);
+  restored_econ.register_household({1, 0, 5000, 0});
+  restored_econ.register_business({20});
+  restored_econ.load_from_persistent_store(restored_store);
+  SAIGE_CHECK(restored_econ.find_household(1)->balance_cents == 3000);
+  SAIGE_CHECK(restored_econ.find_business(20)->inventory_units == 10);
+}
+
+}  // namespace
+
+int main() {
+  test_wage_attendance_and_duplicate_tick_guard();
+  test_purchase_insufficient_funds_exhaustion_and_delivery();
+  test_economic_destinations_and_save_load_consistency();
+  std::cout << "local_economy_test: ALL 3 SUITES PASSED\n";
+  return 0;
+}
diff --git a/demo/urban_world_demo.cpp b/demo/urban_world_demo.cpp
new file mode 100644
--- /dev/null
+++ b/demo/urban_world_demo.cpp
@@ -0,0 +1,211 @@
+#include "saige/crowd_avoidance.hpp"
+#include "saige/multi_floor_nav.hpp"
+#include "saige/npc_simulation.hpp"
+#include "saige/saige_world_adapter.hpp"
+#include "saige/traffic_simulation.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <vector>
+
+struct VehiclePhysicsProxy {
+  double mass_kg = 1500.0;
+  double max_drive_force_n = 4200.0;
+  double max_brake_force_n = 9000.0;
+  double drag_coeff = 0.35;
+  saige::traffic::LaneId lane_id = 1;
+  double s_m = 2.0;
+  double speed_mps = 6.0;
+
+  void integrate(const saige::traffic::VehicleControlInput& ctrl, double dt_sec) noexcept {
+    if (ctrl.requested_lane_change != saige::traffic::LaneChangeCommand::None &&
+        ctrl.target_lane_id != saige::traffic::kInvalidLaneId) {
+      lane_id = ctrl.target_lane_id;
+    }
+    const double drive = ctrl.throttle * max_drive_force_n;
+    const double brake = (ctrl.brake + (ctrl.handbrake ? 1.0 : 0.0)) * max_brake_force_n;
+    const double drag = drag_coeff * speed_mps * speed_mps;
+    const double net_force = drive - (speed_mps > 0.01 ? (brake + drag) : 0.0);
+    speed_mps = std::max(0.0, speed_mps + (net_force / mass_kg) * dt_sec);
+    s_m = std::min(120.0, s_m + speed_mps * dt_sec);
+  }
+};
+
+int main() {
+  using namespace saige;
+
+  world_sim::WorldSimulation world;
+  world_sim::Venue cafe{};
+  cafe.id = 1;
+  cafe.category = world_sim::VenueCategory::Hospitality;
+  cafe.anchor_position = world_sim::WorldPosition::from_world_double({30.0, 10.0, 0.0});
+  cafe.open_minute = 420;
+  cafe.close_minute = 1320;
+  cafe.capacity = 24;
+  world.register_venue(cafe);
+
+  crowd::CrowdSolver crowd;
+  crowd.set_wall_segments({
+      {1, {28.0, 12.0}, {28.0, 25.0}},
+      {2, {28.0, 8.0}, {28.0, -5.0}},
+  });
+  crowd.set_doorways({{10, {28.0, 10.0}, {1.0, 0.0}, 2.0, 5.0}});
+
+  struct NpcSyncState {
+    world_sim::EntityId id = 0;
+    crowd::Vec2d last_dest{};
+    bool has_dest = false;
+    std::size_t route_cursor = 0;
+  };
+  std::vector<NpcSyncState> sync_states;
+
+  for (world_sim::EntityId i = 1; i <= 20; ++i) {
+    const double sx = (i == 1) ? 25.0 : (static_cast<double>(i % 5) * 2.5 + 8.0);
+    const double sy = (i == 1) ? 10.0 : (static_cast<double>(i / 5) * 2.5 + 5.0);
+    world_sim::NpcAgent npc{};
+    npc.id = i;
+    npc.position = world_sim::WorldPosition::from_world_double({sx, sy, 0.0});
+    npc.drives.hunger = 0.85;
+    if (i == 2) {
+      world_sim::WorldSimulation::assign_occupation_schedule(
+          npc, world_sim::OccupationKind::Paramedic, 1, 1);
+    } else {
+      npc.schedule.push_back({420, 1320, 1, world_sim::NpcIntent::Shop});
+    }
+    world.register_npc(npc);
+
+    crowd::CrowdAgent c{};
+    c.id = i;
+    c.position = {sx, sy};
+    c.destination = (i == 1) ? crowd::Vec2d{26.0, 10.0} : crowd::Vec2d{30.0, 10.0};
+    crowd.add_agent(c);
+    sync_states.push_back({i, c.destination, true, 0});
+  }
+
+  multi_floor_nav::MultiFloorNavGraph nav(1.0, 0.35);
+  for (int x = 25; x <= 35; ++x) {
+    nav.set_slice({{x, 10, 0}, 0.0, true, x >= 29});
+    if (x >= 30) nav.set_slice({{x, 10, 1}, 3.5, true, true});
+  }
+  nav.add_portal({1, {32, 10, 0}, {32, 10, 1}, multi_floor_nav::PortalKind::Stair, 4.0, 2.5, true});
+  const auto npc1_route = nav.find_path({26, 10, 0}, {34, 10, 1});
+  multi_floor_nav::PortalTraversalProgress npc1_portal{};
+
+  traffic::TrafficSimulation traffic_sim;
+  traffic_sim.add_lane({1, {0.0, 10.0}, {120.0, 10.0}, 3.5, 13.89, 1,
+                        traffic::kInvalidLaneId, traffic::kInvalidLaneId, {}});
+  traffic_sim.add_crosswalk({1, 1, 22.0, 26.0, false});
+  traffic::IntersectionController inter{};
+  inter.id = 1;
+  inter.phases.push_back({{1}, 12.0, 3.0, 2.0});
+  traffic_sim.add_intersection(inter);
+
+  traffic::TrafficVehicle car{};
+  car.id = 1;
+  car.current_lane = 1;
+  car.s_m = 2.0;
+  car.speed_mps = 6.0;
+  car.use_external_physics = true;
+  traffic_sim.add_vehicle(car);
+  VehiclePhysicsProxy car_physics{};
+
+  constexpr double kDt = 1.0 / 60.0;
+  double current_z_npc1 = 0.0;
+  std::uint32_t crosswalk_brake_ticks = 0;
+  std::uint32_t other_brake_ticks = 0;
+
+  for (int tick = 0; tick < 900; ++tick) {
+    if (tick == 300) {
+      world.report_traffic_accident(99, world_sim::WorldPosition::from_world_double({18.0, 10.0, 0.0}), 10.0);
+    }
+
+    const auto wm = world.step(kDt, world_sim::WorldPosition::from_world_double({25.0, 10.0, 0.0}));
+
+    // Advance smooth portal traversal for NPC #1 (drives character controller/animation)
+    if (npc1_portal.is_active()) {
+      npc1_portal.step(kDt);
+      current_z_npc1 = npc1_portal.current_z_m();
+    }
+
+    for (auto& st : sync_states) {
+      if (st.id == 1 && npc1_route.found && st.route_cursor < npc1_route.waypoints.size()) {
+        if (npc1_portal.is_active()) continue;  // Wait for smooth stair traversal
+        const auto wp = npc1_route.waypoints[st.route_cursor];
+        const crowd::Vec2d wp_xy{static_cast<double>(wp.gx), static_cast<double>(wp.gy)};
+        if (const auto* ca = crowd.find_agent(1)) {
+          const double dx = ca->position.x - wp_xy.x;
+          const double dy = ca->position.y - wp_xy.y;
+          if ((dx * dx + dy * dy) < 0.85 && st.route_cursor + 1 < npc1_route.waypoints.size()) {
+            const auto next_wp = npc1_route.waypoints[st.route_cursor + 1];
+            if (const auto* portal = nav.find_portal_between(wp, next_wp)) {
+              const auto* s_from = nav.find_slice(wp);
+              const auto* s_to = nav.find_slice(next_wp);
+              if (s_from && s_to) {
+                npc1_portal.begin(portal->kind, wp, next_wp, s_from->z_m, s_to->z_m,
+                                  portal->traversal_duration_sec);
+              }
+            }
+            ++st.route_cursor;
+            const crowd::Vec2d next_xy{static_cast<double>(next_wp.gx), static_cast<double>(next_wp.gy)};
+            crowd.set_agent_destination(1, next_xy);
+            st.last_dest = next_xy;
+          }
+        }
+        continue;
+      }
+
+      const auto* npc = world.find_npc(st.id);
+      if (npc != nullptr && npc->current_nav_intent.has_destination) {
+        const auto d = npc->current_nav_intent.target_position.to_world_double();
+        if (!st.has_dest || std::abs(d.x - st.last_dest.x) > 1e-3 ||
+            std::abs(d.y - st.last_dest.y) > 1e-3) {
+          crowd.set_agent_destination(st.id, {d.x, d.y});
+          st.last_dest = {d.x, d.y};
+          st.has_dest = true;
+        }
+      }
+    }
+
+    const auto cm = crowd.step(kDt);
+
+    bool ped_in_crosswalk = false;
+    for (const auto& ca : crowd.agents()) {
+      if (auto* npc = world.find_npc(ca.id)) {
+        const double z = (ca.id == 1) ? current_z_npc1 : 0.0;
+        npc->position = world_sim::WorldPosition::from_world_double({ca.position.x, ca.position.y, z});
+      }
+      if (ca.position.x >= 22.0 && ca.position.x <= 26.0 &&
+          ca.position.y >= 8.0 && ca.position.y <= 12.0) {
+        ped_in_crosswalk = true;
+      }
+    }
+    traffic_sim.set_crosswalk_occupied(1, ped_in_crosswalk);
+
+    const auto tm = traffic_sim.step(kDt);
+    if (const auto* tv = traffic_sim.find_vehicle(1)) {
+      car_physics.integrate(tv->control_output, kDt);
+      traffic_sim.sync_external_vehicle_state(1, car_physics.lane_id,
+                                              car_physics.s_m, car_physics.speed_mps);
+      if (tv->control_output.brake > 0.1) {
+        if (tv->control_output.brake_reason == traffic::BrakeReason::OccupiedCrosswalk) {
+          ++crosswalk_brake_ticks;
+        } else {
+          ++other_brake_ticks;
+        }
+      }
+    }
+
+    if (tick == 899) {
+      std::cout << "[urban_world_demo tick=900] npcs=" << wm.total_npcs
+                << " crowd_arrived=" << cm.arrived_agents
+                << " crowd_max_overlap=" << cm.max_overlap_depth_m
+                << "m npc1_z=" << current_z_npc1
+                << "m car_s=" << car_physics.s_m
+                << "m crosswalk_brake_ticks=" << crosswalk_brake_ticks
+                << " other_brake_ticks=" << other_brake_ticks
+                << " traffic_veh=" << tm.total_vehicles << "\n";
+    }
+  }
+  return 0;
+}
