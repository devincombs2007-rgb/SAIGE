+bool ModelRenderer::posed_world_bounds(const GpuPrimitive& prim, const SkinPalette& palette, const Mat4& world, Float3& lo, Float3& hi) noexcept
+{
+    constexpr float inf = std::numeric_limits<float>::infinity();
+    lo = {inf, inf, inf};
+    hi = {-inf, -inf, -inf};
