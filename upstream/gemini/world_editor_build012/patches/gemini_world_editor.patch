+  broken.uri = "assets/props/bench_01.glb";
+  broken.display_name = "Park Bench";
+  broken.content_hash = 0xCAFEBABE0001ULL;  // duplicate of 101
+  broken.dependencies = {"assets/materials/missing_wood.mat"};
