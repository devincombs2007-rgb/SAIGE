+  SAIGE_CHECK(EditorProjectSerializer::deserialize(blob2, s3));
+  SAIGE_CHECK(s3.find_node(1)->asset.content_hash == 0xABCDULL);
+  SAIGE_CHECK(s3.find_node(2)->asset.content_hash == 0xDEADULL);
