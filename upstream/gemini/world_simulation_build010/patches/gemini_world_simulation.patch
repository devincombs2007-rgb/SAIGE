+#pragma once
+
+#include "saige/npc_simulation.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace saige::psychology {
+
+struct EmotionalState {
+  double valence = 0.1;  // [-1.0 negative, +1.0 positive]
+  double arousal = 0.2;  // [0.0 calm, 1.0 excited/panicked]
+  double fear = 0.0;     // [0.0, 1.0]
+  double anger = 0.0;    // [0.0, 1.0]
+  double stress = 0.1;   // [0.0, 1.0]
+
+  void step_decay(double dt_seconds) noexcept;
+};
+
+struct PersonalHabits {
+  world_sim::VenueCategory preferred_category = world_sim::VenueCategory::Hospitality;
+  double punctuality = 0.6;      // [0.0, 1.0]
+  double risk_tolerance = 0.4;   // [0.0, 1.0]
+  double social_battery = 0.7;   // [0.0, 1.0]
+  double weather_sensitivity = 0.5;
+};
+
+struct ExperienceEntry {
+  world_sim::VenueId venue_id = world_sim::kInvalidVenueId;
+  world_sim::EntityId actor_id = world_sim::kInvalidEntityId;
+  double sentiment = 0.0;  // [-1.0 bad experience, +1.0 good experience]
+  double timestamp_sec = 0.0;
+};
+
+// Reusable environmental contract for engine weather/time/hazard integration.
+struct EnvironmentalCondition {
+  double rain_intensity = 0.0;   // [0.0, 1.0]
+  double storm_severity = 0.0;   // [0.0, 1.0]
+  double temperature_c = 20.0;   // Celsius
+  double flood_depth_m = 0.0;    // Local water depth
+  double visibility_m = 200.0;
+};
+
+enum class ContextualAction : std::uint8_t {
+  FollowRoutine = 0,
+  SeekShelter = 1,
+  AvoidArea = 2,
+  FleeHazard = 3,
+  EngageSocial = 4,
+};
+
+struct PsychologyDecision {
+  ContextualAction action = ContextualAction::FollowRoutine;
+  double speed_multiplier = 1.0;
+  double venue_bias = 0.0;
+};
+
+class NpcPsychologyProfile {
+ public:
+  explicit NpcPsychologyProfile(world_sim::EntityId seed_id = 1);
+
+  void record_experience(const ExperienceEntry& entry);
+  void apply_emotional_stimulus(double delta_valence, double delta_fear,
+                                double delta_anger, double delta_stress) noexcept;
+  void step(double dt_seconds, const EnvironmentalCondition& env) noexcept;
+
+  [[nodiscard]] double venue_affinity(world_sim::VenueId venue_id) const noexcept;
+  [[nodiscard]] PsychologyDecision evaluate(
+      const EnvironmentalCondition& env,
+      world_sim::VenueId candidate_venue) const noexcept;
+
+  [[nodiscard]] const EmotionalState& emotions() const noexcept { return emotions_; }
+  [[nodiscard]] const PersonalHabits& habits() const noexcept { return habits_; }
+  [[nodiscard]] std::size_t experience_count() const noexcept {
+    return experiences_.size();
+  }
+
+ private:
+  EmotionalState emotions_{};
+  PersonalHabits habits_{};
+  std::vector<ExperienceEntry> experiences_;
+  std::size_t max_experiences_ = 32;
+};
+
+}  // namespace saige::psychology
diff --git a/src/npc_psychology.cpp b/src/npc_psychology.cpp
new file mode 100644
--- /dev/null
+++ b/src/npc_psychology.cpp
@@ -0,0 +1,133 @@
+#include "saige/npc_psychology.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace saige::psychology {
+
+namespace {
+
+[[nodiscard]] double clamp(double v, double lo, double hi) noexcept {
+  if (!std::isfinite(v)) return lo;
+  if (v < lo) return lo;
+  if (v > hi) return hi;
+  return v;
+}
+
+[[nodiscard]] double hash_unit(std::uint64_t x) noexcept {
+  x ^= x >> 33;
+  x *= 0xff51afd7ed558ccdULL;
+  x ^= x >> 33;
+  x *= 0xc4ceb9fe1a85ec53ULL;
+  x ^= x >> 33;
+  return static_cast<double>(x & 0xFFFFu) / 65535.0;
+}
+
+}  // namespace
+
+void EmotionalState::step_decay(double dt_seconds) noexcept {
+  if (!std::isfinite(dt_seconds) || dt_seconds <= 0.0) return;
+  const double rate = std::min(1.0, dt_seconds * 0.05);
+  valence += (0.1 - valence) * rate;
+  arousal += (0.2 - arousal) * rate;
+  fear = clamp(fear - 0.04 * dt_seconds, 0.0, 1.0);
+  anger = clamp(anger - 0.03 * dt_seconds, 0.0, 1.0);
+  stress = clamp(stress - 0.02 * dt_seconds, 0.0, 1.0);
+}
+
+NpcPsychologyProfile::NpcPsychologyProfile(world_sim::EntityId seed_id) {
+  // Deterministic per-NPC behavioral variation without runtime RNG
+  habits_.punctuality = 0.35 + 0.60 * hash_unit(seed_id * 17ULL + 1ULL);
+  habits_.risk_tolerance = 0.15 + 0.75 * hash_unit(seed_id * 31ULL + 3ULL);
+  habits_.social_battery = 0.25 + 0.70 * hash_unit(seed_id * 47ULL + 7ULL);
+  habits_.weather_sensitivity = 0.20 + 0.75 * hash_unit(seed_id * 59ULL + 11ULL);
+  const auto cat_idx = static_cast<std::uint8_t>((seed_id % 4) + 1);
+  habits_.preferred_category = static_cast<world_sim::VenueCategory>(cat_idx);
+}
+
+void NpcPsychologyProfile::record_experience(const ExperienceEntry& entry) {
+  if (!std::isfinite(entry.sentiment)) return;
+  ExperienceEntry clamped = entry;
+  clamped.sentiment = clamp(entry.sentiment, -1.0, 1.0);
+  while (experiences_.size() >= max_experiences_) {
+    experiences_.erase(experiences_.begin());
+  }
+  experiences_.push_back(clamped);
+}
+
+void NpcPsychologyProfile::apply_emotional_stimulus(double delta_valence,
+                                                    double delta_fear,
+                                                    double delta_anger,
+                                                    double delta_stress) noexcept {
+  emotions_.valence = clamp(emotions_.valence + delta_valence, -1.0, 1.0);
+  emotions_.fear = clamp(emotions_.fear + delta_fear, 0.0, 1.0);
+  emotions_.anger = clamp(emotions_.anger + delta_anger, 0.0, 1.0);
+  emotions_.stress = clamp(emotions_.stress + delta_stress, 0.0, 1.0);
+  emotions_.arousal = clamp(
+      std::max(emotions_.arousal, 0.5 * emotions_.fear + 0.4 * emotions_.anger),
+      0.0, 1.0);
+}
+
+void NpcPsychologyProfile::step(double dt_seconds,
+                                const EnvironmentalCondition& env) noexcept {
+  emotions_.step_decay(dt_seconds);
+  if (env.storm_severity > 0.5 || env.flood_depth_m > 0.15) {
+    const double sev = std::max(env.storm_severity, env.flood_depth_m);
+    emotions_.stress = clamp(
+        emotions_.stress + 0.04 * sev * habits_.weather_sensitivity * dt_seconds,
+        0.0, 1.0);
+  }
+}
+
+double NpcPsychologyProfile::venue_affinity(
+    world_sim::VenueId venue_id) const noexcept {
+  if (venue_id == world_sim::kInvalidVenueId) return 0.0;
+  double sum = 0.0;
+  std::uint32_t count = 0;
+  for (const auto& e : experiences_) {
+    if (e.venue_id == venue_id) {
+      sum += e.sentiment;
+      ++count;
+    }
+  }
+  return (count > 0) ? (sum / static_cast<double>(count)) : 0.0;
+}
+
+PsychologyDecision NpcPsychologyProfile::evaluate(
+    const EnvironmentalCondition& env,
+    world_sim::VenueId candidate_venue) const noexcept {
+  PsychologyDecision out{};
+  out.venue_bias = venue_affinity(candidate_venue);
+
+  if (env.flood_depth_m > 0.25 || emotions_.fear > 0.75) {
+    out.action = ContextualAction::FleeHazard;
+    out.speed_multiplier = 1.6;
+    return out;
+  }
+
+  if (env.rain_intensity * habits_.weather_sensitivity > 0.45 ||
+      env.storm_severity > 0.55 || env.temperature_c < -5.0 ||
+      env.temperature_c > 42.0) {
+    out.action = ContextualAction::SeekShelter;
+    out.speed_multiplier = 1.35;
+    return out;
+  }
+
+  if (out.venue_bias < -0.45 && habits_.risk_tolerance < 0.7) {
+    out.action = ContextualAction::AvoidArea;
+    out.speed_multiplier = 1.1;
+    return out;
+  }
+
+  if (emotions_.valence > 0.35 && habits_.social_battery > 0.5) {
+    out.action = ContextualAction::EngageSocial;
+    out.speed_multiplier = 1.0;
+    return out;
+  }
+
+  out.action = ContextualAction::FollowRoutine;
+  out.speed_multiplier = 1.0;
+  return out;
+}
+
+}  // namespace saige::psychology
diff --git a/tests/npc_psychology_test.cpp b/tests/npc_psychology_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/npc_psychology_test.cpp
@@ -0,0 +1,72 @@
+#include "saige/npc_psychology.hpp"
+
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+
+#define SAIGE_CHECK(cond)                                                     \
+  do {                                                                        \
+    if (!(cond)) {                                                            \
+      std::cerr << "SAIGE_CHECK FAILED at " << __FILE__ << ":" << __LINE__    \
+                << " (" << #cond << ")\n";                                    \
+      std::exit(1);                                                           \
+    }                                                                         \
+  } while (false)
+
+using namespace saige::psychology;
+using namespace saige::world_sim;
+
+namespace {
+
+void test_individual_habit_variation_is_deterministic() {
+  NpcPsychologyProfile a1(101);
+  NpcPsychologyProfile a2(101);
+  NpcPsychologyProfile b(202);
+
+  SAIGE_CHECK(std::abs(a1.habits().punctuality - a2.habits().punctuality) < 1e-9);
+  SAIGE_CHECK(std::abs(a1.habits().punctuality - b.habits().punctuality) > 1e-3);
+}
+
+void test_experience_memory_and_environmental_reactions() {
+  NpcPsychologyProfile prof(55);
+  prof.record_experience({10, 0, -0.8, 10.0});
+  SAIGE_CHECK(prof.venue_affinity(10) < -0.5);
+
+  EnvironmentalCondition calm{};
+  const auto avoid_dec = prof.evaluate(calm, 10);
+  if (prof.habits().risk_tolerance < 0.7) {
+    SAIGE_CHECK(avoid_dec.action == ContextualAction::AvoidArea);
+  }
+
+  EnvironmentalCondition storm{};
+  storm.storm_severity = 0.85;
+  storm.rain_intensity = 0.9;
+  const auto storm_dec = prof.evaluate(storm, 20);
+  SAIGE_CHECK(storm_dec.action == ContextualAction::SeekShelter);
+
+  EnvironmentalCondition flood{};
+  flood.flood_depth_m = 0.45;
+  const auto flood_dec = prof.evaluate(flood, 20);
+  SAIGE_CHECK(flood_dec.action == ContextualAction::FleeHazard);
+}
+
+void test_emotional_stimulus_and_decay() {
+  NpcPsychologyProfile prof(7);
+  prof.apply_emotional_stimulus(-0.7, 0.85, 0.2, 0.6);
+  SAIGE_CHECK(prof.emotions().fear > 0.8);
+  SAIGE_CHECK(prof.evaluate(EnvironmentalCondition{}, 1).action ==
+              ContextualAction::FleeHazard);
+
+  prof.step(20.0, EnvironmentalCondition{});
+  SAIGE_CHECK(prof.emotions().fear < 0.2);
+}
+
+}  // namespace
+
+int main() {
+  test_individual_habit_variation_is_deterministic();
+  test_experience_memory_and_environmental_reactions();
+  test_emotional_stimulus_and_decay();
+  std::cout << "npc_psychology_test: ALL 3 SUITES PASSED\n";
+  return 0;
+}
diff --git a/include/saige/social_simulation.hpp b/include/saige/social_simulation.hpp
new file mode 100644
--- /dev/null
+++ b/include/saige/social_simulation.hpp
@@ -0,0 +1,98 @@
+#pragma once
+
+#include "saige/npc_psychology.hpp"
+#include "saige/npc_simulation.hpp"
+#include "saige/persistent_world.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace saige::social {
+
+enum class SocialAction : std::uint8_t {
+  None = 0,
+  WaveGreeting = 1,
+  FriendlyChat = 2,
+  DeepConversation = 3,
+  HelpAlly = 4,
+  Avoid = 5,
+  Confront = 6,
+};
+
+struct SocialEdge {
+  world_sim::EntityId a = world_sim::kInvalidEntityId;
+  world_sim::EntityId b = world_sim::kInvalidEntityId;
+  persistent_world::RelationshipKind kind =
+      persistent_world::RelationshipKind::Acquaintance;
+  float familiarity = 0.0f;  // [0.0, 1.0]
+  float affinity = 0.0f;     // [-1.0, 1.0]
+  float trust = 0.0f;        // [-1.0, 1.0]
+  std::uint32_t interaction_count = 0;
+  double last_interaction_sec = -1000.0;
+};
+
+struct SocialGathering {
+  std::uint32_t id = 0;
+  world_sim::VenueId venue_id = world_sim::kInvalidVenueId;
+  world_sim::WorldPosition center{};
+  std::uint16_t start_minute = 1080;  // 18:00
+  std::uint16_t end_minute = 1260;    // 21:00
+  std::vector<world_sim::EntityId> participants;
+
+  [[nodiscard]] bool is_active(std::uint16_t minute_of_day) const noexcept;
+};
+
+struct SocialEncounterDecision {
+  SocialAction action = SocialAction::None;
+  double affinity_delta = 0.0;
+  double trust_delta = 0.0;
+  double emotion_valence_delta = 0.0;
+};
+
+class SocialNetwork {
+ public:
+  bool set_relationship(const SocialEdge& edge);
+  [[nodiscard]] const SocialEdge* find_relationship(
+      world_sim::EntityId a, world_sim::EntityId b) const noexcept;
+  [[nodiscard]] SocialEdge* find_relationship_mut(
+      world_sim::EntityId a, world_sim::EntityId b) noexcept;
+
+  // Evaluates contextual social action from relationship + personality + emotion + weather.
+  [[nodiscard]] SocialEncounterDecision evaluate_encounter(
+      const world_sim::NpcAgent& actor, const world_sim::NpcAgent& target,
+      const psychology::NpcPsychologyProfile& actor_psych,
+      const psychology::EnvironmentalCondition& env,
+      double current_time_sec,
+      double max_encounter_distance_m = 6.0) const noexcept;
+
+  // Executes encounter, updating relationship (Acquaintance->Friend/Rival),
+  // psychology experience/emotions, and optionally persistent world records.
+  bool apply_encounter(world_sim::NpcAgent& actor, world_sim::NpcAgent& target,
+                       psychology::NpcPsychologyProfile& actor_psych,
+                       const psychology::EnvironmentalCondition& env,
+                       double current_time_sec,
+                       double max_encounter_distance_m = 6.0);
+
+  bool add_gathering(const SocialGathering& gathering);
+  [[nodiscard]] world_sim::WorldPosition compute_group_formation_slot(
+      const world_sim::WorldPosition& leader_pos, std::size_t member_idx,
+      std::size_t group_size, double chunk_size_m = 64.0) const noexcept;
+
+  // Connects active social gatherings directly to NpcAgent schedule/navigation intents.
+  std::uint32_t apply_gathering_schedules(
+      std::vector<world_sim::NpcAgent>& npcs,
+      std::uint16_t minute_of_day) const;
+
+  void sync_to_persistent_store(
+      persistent_world::PersistentWorldStore& store) const;
+  void load_from_persistent_store(
+      const persistent_world::PersistentWorldStore& store);
+
+  [[nodiscard]] std::size_t edge_count() const noexcept { return edges_.size(); }
+
+ private:
+  std::vector<SocialEdge> edges_;
+  std::vector<SocialGathering> gatherings_;
+};
+
+}  // namespace saige::social
diff --git a/src/social_simulation.cpp b/src/social_simulation.cpp
new file mode 100644
--- /dev/null
+++ b/src/social_simulation.cpp
@@ -0,0 +1,266 @@
+#include "saige/social_simulation.hpp"
+
+#include <algorithm>
+#include <cmath>
+
+namespace saige::social {
+
+namespace {
+
+[[nodiscard]] float clampf(float v, float lo, float hi) noexcept {
+  if (!std::isfinite(v) || v < lo) return lo;
+  if (v > hi) return hi;
+  return v;
+}
+
+[[nodiscard]] std::pair<world_sim::EntityId, world_sim::EntityId> canonical_pair(
+    world_sim::EntityId x, world_sim::EntityId y) noexcept {
+  return (x < y) ? std::pair{x, y} : std::pair{y, x};
+}
+
+}  // namespace
+
+bool SocialGathering::is_active(std::uint16_t minute_of_day) const noexcept {
+  if (start_minute == end_minute) return true;
+  if (start_minute < end_minute) {
+    return minute_of_day >= start_minute && minute_of_day < end_minute;
+  }
+  return minute_of_day >= start_minute || minute_of_day < end_minute;
+}
+
+bool SocialNetwork::set_relationship(const SocialEdge& edge) {
+  if (edge.a == world_sim::kInvalidEntityId ||
+      edge.b == world_sim::kInvalidEntityId || edge.a == edge.b) {
+    return false;
+  }
+  const auto [ca, cb] = canonical_pair(edge.a, edge.b);
+  SocialEdge norm = edge;
+  norm.a = ca;
+  norm.b = cb;
+  if (auto* existing = find_relationship_mut(ca, cb)) {
+    *existing = norm;
+    return true;
+  }
+  edges_.push_back(norm);
+  std::sort(edges_.begin(), edges_.end(), [](const SocialEdge& x, const SocialEdge& y) {
+    if (x.a != y.a) return x.a < y.a;
+    return x.b < y.b;
+  });
+  return true;
+}
+
+const SocialEdge* SocialNetwork::find_relationship(
+    world_sim::EntityId a, world_sim::EntityId b) const noexcept {
+  const auto [ca, cb] = canonical_pair(a, b);
+  for (const auto& e : edges_) {
+    if (e.a == ca && e.b == cb) return &e;
+  }
+  return nullptr;
+}
+
+SocialEdge* SocialNetwork::find_relationship_mut(
+    world_sim::EntityId a, world_sim::EntityId b) noexcept {
+  const auto [ca, cb] = canonical_pair(a, b);
+  for (auto& e : edges_) {
+    if (e.a == ca && e.b == cb) return &e;
+  }
+  return nullptr;
+}
+
+SocialEncounterDecision SocialNetwork::evaluate_encounter(
+    const world_sim::NpcAgent& actor, const world_sim::NpcAgent& target,
+    const psychology::NpcPsychologyProfile& actor_psych,
+    const psychology::EnvironmentalCondition& env,
+    double current_time_sec,
+    double max_encounter_distance_m) const noexcept {
+  SocialEncounterDecision out{};
+  if (actor.id == target.id) return out;
+  if (world_sim::WorldPosition::distance(actor.position, target.position) >
+      max_encounter_distance_m) {
+    return out;
+  }
+
+  const SocialEdge* edge = find_relationship(actor.id, target.id);
+  const float aff = edge ? edge->affinity : 0.0f;
+  const float trust = edge ? edge->trust : 0.0f;
+  const float fam = edge ? edge->familiarity : 0.0f;
+
+  // Cooldown to avoid spamming interactions every tick
+  if (edge != nullptr && (current_time_sec - edge->last_interaction_sec) < 10.0) {
+    return out;
+  }
+
+  // Confront or Avoid negative relationships
+  if (aff < -0.45f || trust < -0.40f) {
+    if (actor_psych.emotions().anger > 0.55 || actor.personality.aggression > 0.65) {
+      out.action = SocialAction::Confront;
+      out.affinity_delta = -0.10;
+      out.trust_delta = -0.10;
+      out.emotion_valence_delta = -0.20;
+    } else {
+      out.action = SocialAction::Avoid;
+      out.affinity_delta = -0.02;
+      out.trust_delta = -0.02;
+      out.emotion_valence_delta = -0.05;
+    }
+    return out;
+  }
+
+  // Help distressed ally or family member
+  if ((aff > 0.30f || (edge && edge->kind == persistent_world::RelationshipKind::Family)) &&
+      target.drives.safety < 0.55) {
+    out.action = SocialAction::HelpAlly;
+    out.affinity_delta = 0.12;
+    out.trust_delta = 0.15;
+    out.emotion_valence_delta = 0.15;
+    return out;
+  }
+
+  // Storm/emergency reduces casual chat to brief wave
+  if (env.storm_severity > 0.6 || actor_psych.emotions().fear > 0.5) {
+    if (fam > 0.25f) {
+      out.action = SocialAction::WaveGreeting;
+      out.affinity_delta = 0.02;
+      out.trust_delta = 0.01;
+      out.emotion_valence_delta = 0.05;
+    }
+    return out;
+  }
+
+  if (fam > 0.45f && aff > 0.35f && actor_psych.habits().social_battery > 0.4) {
+    out.action = SocialAction::DeepConversation;
+    out.affinity_delta = 0.08;
+    out.trust_delta = 0.06;
+    out.emotion_valence_delta = 0.15;
+  } else if (actor.personality.sociability > 0.35 || fam > 0.15f) {
+    out.action = SocialAction::FriendlyChat;
+    out.affinity_delta = 0.06;
+    out.trust_delta = 0.04;
+    out.emotion_valence_delta = 0.10;
+  } else {
+    out.action = SocialAction::WaveGreeting;
+    out.affinity_delta = 0.03;
+    out.trust_delta = 0.02;
+    out.emotion_valence_delta = 0.04;
+  }
+  return out;
+}
+
+bool SocialNetwork::apply_encounter(
+    world_sim::NpcAgent& actor, world_sim::NpcAgent& target,
+    psychology::NpcPsychologyProfile& actor_psych,
+    const psychology::EnvironmentalCondition& env, double current_time_sec,
+    double max_encounter_distance_m) {
+  const auto dec = evaluate_encounter(actor, target, actor_psych, env,
+                                      current_time_sec, max_encounter_distance_m);
+  if (dec.action == SocialAction::None) return false;
+
+  SocialEdge* edge = find_relationship_mut(actor.id, target.id);
+  if (edge == nullptr) {
+    SocialEdge created{};
+    const auto [ca, cb] = canonical_pair(actor.id, target.id);
+    created.a = ca;
+    created.b = cb;
+    set_relationship(created);
+    edge = find_relationship_mut(actor.id, target.id);
+  }
+  if (edge == nullptr) return false;
+
+  edge->familiarity = clampf(edge->familiarity + 0.10f, 0.0f, 1.0f);
+  edge->affinity =
+      clampf(edge->affinity + static_cast<float>(dec.affinity_delta), -1.0f, 1.0f);
+  edge->trust =
+      clampf(edge->trust + static_cast<float>(dec.trust_delta), -1.0f, 1.0f);
+  ++edge->interaction_count;
+  edge->last_interaction_sec = current_time_sec;
+
+  // Natural relationship progression from repeated interactions
+  if (edge->kind == persistent_world::RelationshipKind::Acquaintance &&
+      edge->affinity >= 0.45f && edge->familiarity >= 0.40f) {
+    edge->kind = persistent_world::RelationshipKind::Friend;
+  } else if (edge->affinity <= -0.50f) {
+    edge->kind = persistent_world::RelationshipKind::Rival;
+  }
+
+  actor_psych.apply_emotional_stimulus(dec.emotion_valence_delta, 0.0,
+                                       dec.action == SocialAction::Confront ? 0.15 : 0.0,
+                                       0.0);
+  actor_psych.record_experience(
+      {world_sim::kInvalidVenueId, target.id, dec.affinity_delta * 2.0, current_time_sec});
+  actor.drives.social = std::min(1.0, actor.drives.social + 0.15);
+  return true;
+}
+
+bool SocialNetwork::add_gathering(const SocialGathering& gathering) {
+  if (gathering.id == 0) return false;
+  for (const auto& g : gatherings_) {
+    if (g.id == gathering.id) return false;
+  }
+  gatherings_.push_back(gathering);
+  return true;
+}
+
+world_sim::WorldPosition SocialNetwork::compute_group_formation_slot(
+    const world_sim::WorldPosition& leader_pos, std::size_t member_idx,
+    std::size_t group_size, double chunk_size_m) const noexcept {
+  if (group_size <= 1) return leader_pos;
+  constexpr double kTwoPi = 6.283185307179586;
+  const double angle =
+      (static_cast<double>(member_idx) / static_cast<double>(group_size)) * kTwoPi;
+  const double radius_m = 1.8;
+  const world_sim::Vec3d w = leader_pos.to_world_double(chunk_size_m);
+  return world_sim::WorldPosition::from_world_double(
+      {w.x + std::cos(angle) * radius_m, w.y + std::sin(angle) * radius_m, w.z},
+      chunk_size_m);
+}
+
+std::uint32_t SocialNetwork::apply_gathering_schedules(
+    std::vector<world_sim::NpcAgent>& npcs, std::uint16_t minute_of_day) const {
+  std::uint32_t scheduled = 0;
+  for (const auto& g : gatherings_) {
+    if (!g.is_active(minute_of_day)) continue;
+    const std::size_t n = g.participants.size();
+    for (std::size_t idx = 0; idx < n; ++idx) {
+      const world_sim::EntityId pid = g.participants[idx];
+      for (auto& npc : npcs) {
+        if (npc.id == pid) {
+          // Behavioral priority arbitration: never override urgent/emergency intents
+          if (npc.current_nav_intent.urgent ||
+              npc.current_nav_intent.intent == world_sim::NpcIntent::Flee ||
+              npc.current_nav_intent.intent == world_sim::NpcIntent::Assist ||
+              npc.current_nav_intent.intent == world_sim::NpcIntent::Investigate) {
+            break;
+          }
+          npc.current_nav_intent.intent = world_sim::NpcIntent::Socialize;
+          npc.current_nav_intent.has_destination = true;
+          npc.current_nav_intent.target_venue = g.venue_id;
+          npc.current_nav_intent.target_position =
+              compute_group_formation_slot(g.center, idx, n);
+          ++scheduled;
+          break;
+        }
+      }
+    }
+  }
+  return scheduled;
+}
+
+void SocialNetwork::sync_to_persistent_store(
+    persistent_world::PersistentWorldStore& store) const {
+  for (const auto& e : edges_) {
+    store.upsert_relationship({e.a, e.b, e.kind, e.affinity, e.familiarity,
+                               e.trust, e.interaction_count,
+                               e.last_interaction_sec});
+  }
+}
+
+void SocialNetwork::load_from_persistent_store(
+    const persistent_world::PersistentWorldStore& store) {
+  edges_.clear();
+  for (const auto& r : store.relationships()) {
+    set_relationship({r.from_id, r.to_id, r.kind, r.affinity, r.familiarity,
+                      r.trust, r.interaction_count, r.last_interaction_sec});
+  }
+}
+
+}  // namespace saige::social
diff --git a/tests/social_simulation_test.cpp b/tests/social_simulation_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/social_simulation_test.cpp
@@ -0,0 +1,139 @@
+#include "saige/social_simulation.hpp"
+
+#include <cmath>
+#include <cstdlib>
+#include <iostream>
+
+#define SAIGE_CHECK(cond)                                                     \
+  do {                                                                        \
+    if (!(cond)) {                                                            \
+      std::cerr << "SAIGE_CHECK FAILED at " << __FILE__ << ":" << __LINE__    \
+                << " (" << #cond << ")\n";                                    \
+      std::exit(1);                                                           \
+    }                                                                         \
+  } while (false)
+
+using namespace saige::social;
+using namespace saige::world_sim;
+using namespace saige::psychology;
+using namespace saige::persistent_world;
+
+namespace {
+
+void test_relationship_progression_and_persistence() {
+  SocialNetwork net;
+  NpcAgent a{};
+  a.id = 1;
+  a.personality.sociability = 0.8;
+  NpcAgent b{};
+  b.id = 2;
+  NpcPsychologyProfile psych_a(1);
+  EnvironmentalCondition env{};
+
+  // Repeated positive interactions evolve Acquaintance -> Friend
+  for (int i = 0; i < 8; ++i) {
+    SAIGE_CHECK(net.apply_encounter(a, b, psych_a, env, static_cast<double>(i) * 15.0));
+  }
+  const auto* edge = net.find_relationship(1, 2);
+  SAIGE_CHECK(edge != nullptr);
+  SAIGE_CHECK(edge->interaction_count == 8);
+  SAIGE_CHECK(edge->kind == RelationshipKind::Friend);
+  SAIGE_CHECK(edge->affinity >= 0.45f);
+
+  PersistentWorldStore store;
+  net.sync_to_persistent_store(store);
+  const auto blob = store.serialize();
+
+  PersistentWorldStore restored_store;
+  SAIGE_CHECK(restored_store.deserialize(blob));
+
+  SocialNetwork restored_net;
+  restored_net.load_from_persistent_store(restored_store);
+  SAIGE_CHECK(restored_net.edge_count() == 1);
+  SAIGE_CHECK(restored_net.find_relationship(1, 2)->kind == RelationshipKind::Friend);
+}
+
+void test_helping_avoiding_and_confronting() {
+  SocialNetwork net;
+  SAIGE_CHECK(net.set_relationship({1, 2, RelationshipKind::Family, 0.8f, 0.9f, 0.9f, 5, -50.0}));
+  SAIGE_CHECK(net.set_relationship({3, 4, RelationshipKind::Rival, -0.7f, 0.5f, -0.6f, 3, -50.0}));
+
+  NpcAgent helper{};
+  helper.id = 1;
+  NpcAgent injured_family{};
+  injured_family.id = 2;
+  injured_family.drives.safety = 0.2;
+  NpcPsychologyProfile psych_helper(1);
+
+  const auto help_dec = net.evaluate_encounter(helper, injured_family, psych_helper, EnvironmentalCondition{}, 10.0);
+  SAIGE_CHECK(help_dec.action == SocialAction::HelpAlly);
+
+  NpcAgent angry_rival{};
+  angry_rival.id = 3;
+  angry_rival.personality.aggression = 0.8;
+  NpcAgent rival_target{};
+  rival_target.id = 4;
+  NpcPsychologyProfile psych_rival(3);
+  psych_rival.apply_emotional_stimulus(-0.5, 0.0, 0.7, 0.3);
+
+  const auto conf_dec = net.evaluate_encounter(angry_rival, rival_target, psych_rival, EnvironmentalCondition{}, 10.0);
+  SAIGE_CHECK(conf_dec.action == SocialAction::Confront);
+}
+
+void test_social_gathering_and_group_formation() {
+  SocialNetwork net;
+  const WorldPosition plaza = WorldPosition::from_world_double({50.0, 50.0, 0.0});
+  SAIGE_CHECK(net.add_gathering({10, 5, plaza, 1080, 1260, {1, 2, 3}}));
+
+  std::vector<NpcAgent> npcs(3);
+  npcs[0].id = 1;
+  npcs[1].id = 2;
+  npcs[2].id = 3;
+
+  const std::uint32_t scheduled = net.apply_gathering_schedules(npcs, 1140);
+  SAIGE_CHECK(scheduled == 3);
+  for (const auto& npc : npcs) {
+    SAIGE_CHECK(npc.current_nav_intent.intent == NpcIntent::Socialize);
+    SAIGE_CHECK(npc.current_nav_intent.has_destination);
+  }
+  // Distinct formation slots around gathering center (no stacking)
+  SAIGE_CHECK(WorldPosition::distance(npcs[0].current_nav_intent.target_position,
+                                      npcs[1].current_nav_intent.target_position) > 1.0);
+}
+
+}  // namespace
+
+void test_10km_separation_blocks_encounter_and_flee_priority() {
+  SocialNetwork net;
+  NpcAgent a{};
+  a.id = 1;
+  a.position = WorldPosition::from_world_double({0.0, 0.0, 0.0});
+  a.current_nav_intent.intent = NpcIntent::Flee;
+  a.current_nav_intent.urgent = true;
+
+  NpcAgent b{};
+  b.id = 2;
+  b.position = WorldPosition::from_world_double({10000.0, 0.0, 0.0});  // 10 km away
+  NpcPsychologyProfile psych_a(1);
+
+  SAIGE_CHECK(net.evaluate_encounter(a, b, psych_a, EnvironmentalCondition{}, 10.0).action ==
+              SocialAction::None);
+  SAIGE_CHECK(!net.apply_encounter(a, b, psych_a, EnvironmentalCondition{}, 10.0));
+
+  // Urgent Flee must NOT be overridden by social gathering schedule
+  SAIGE_CHECK(net.add_gathering({20, 5, WorldPosition{}, 1080, 1260, {1, 2}}));
+  std::vector<NpcAgent> group{a, b};
+  const std::uint32_t scheduled = net.apply_gathering_schedules(group, 1140);
+  SAIGE_CHECK(scheduled == 1);  // Only NPC 2 scheduled
+  SAIGE_CHECK(group[0].current_nav_intent.intent == NpcIntent::Flee);
+  SAIGE_CHECK(group[0].current_nav_intent.urgent);
+}
+
+int main() {
+  test_relationship_progression_and_persistence();
+  test_helping_avoiding_and_confronting();
+  test_social_gathering_and_group_formation();
+  test_10km_separation_blocks_encounter_and_flee_priority();
+  std::cout << "social_simulation_test: ALL 4 SUITES PASSED\n";
+  return 0;
+}
